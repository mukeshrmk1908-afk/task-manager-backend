<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= filename %> - Details</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-zinc-900 text-white min-h-screen">
    <div class="main w-full min-h-screen p-10 max-w-4xl mx-auto">
        <!-- Back Navigation Link -->
        <a class="text-blue-500 hover:text-blue-400 inline-flex items-center gap-1 mb-8 text-sm" href="/">
            &larr; Go back to home
        </a>

        <!-- Task File Header -->
        <div class="flex items-center justify-between border-b border-zinc-800 pb-4 mb-6">
            <h1 class="text-3xl font-semibold tracking-tight text-white"><%= filename %></h1>
            <div class="flex items-center gap-3">
                <a class="bg-zinc-800 hover:bg-zinc-700 text-zinc-300 px-4 py-2 rounded-md text-sm transition" href="/edit/<%= filename %>">
                    Rename
                </a>
                <form action="/delete/<%= filename %>" method="post" onsubmit="return confirm('Are you sure you want to delete this task?');">
                    <button type="submit" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-md text-sm transition">
                        Delete
                    </button>
                </form>
            </div>
        </div>

        <!-- Task Content Box -->
        <div class="bg-zinc-800 p-6 rounded-md shadow">
            <h2 class="text-xs uppercase tracking-wider text-zinc-500 font-semibold mb-3">Task Content</h2>
            <% if (filedata && filedata.trim().length > 0) { %>
                <p class="text-zinc-200 text-base leading-relaxed whitespace-pre-wrap"><%= filedata %></p>
            <% } else { %>
                <p class="text-zinc-500 italic">No details were provided for this task.</p>
            <% } %>
        </div>
    </div>
</body>
</html>
