<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task Manager</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-zinc-900 text-white min-h-screen">
    <div class="main w-full min-h-screen p-10">
        <!-- Task Creation Form -->
        <div class="form">
            <form action="/create" method="post">
                <input 
                    class="block w-full rounded-md outline-none px-5 py-2 bg-zinc-800 text-white placeholder-zinc-500 text-base" 
                    type="text" 
                    placeholder="Title goes here.." 
                    name="title"
                >
                <textarea 
                    class="block w-full rounded-md outline-none px-5 py-2 bg-zinc-800 text-white placeholder-zinc-500 resize-none mt-2 text-base h-28" 
                    placeholder="Write your task details here..." 
                    name="details"
                ></textarea>
                <input 
                    class="mt-2 bg-blue-600 hover:bg-blue-700 px-5 py-2 rounded-md font-medium cursor-pointer text-white transition-colors duration-200" 
                    type="submit" 
                    value="Create Task"
                >
            </form>
        </div>

        <!-- Task Cards Display Grid -->
        <div class="tasks flex gap-3 flex-wrap mt-10">
            <% if (files && files.length > 0) { %>
                <% files.forEach(function(val) { %>
                    <div class="task w-72 px-4 py-4 bg-zinc-800 rounded-md flex flex-col justify-between">
                        <h1 class="text-white text-2xl font-normal tracking-tight break-all"><%= val %></h1>
                        <div class="flex items-center justify-between mt-3">
                            <a class="text-blue-500 hover:text-blue-400 text-sm inline-block" href="/file/<%= val %>">read more</a>
                            <a class="text-zinc-500 hover:text-zinc-300 text-xs inline-block" href="/edit/<%= val %>">edit</a>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <h3 class="text-zinc-500 text-sm">No tasks yet. Create your first task above!</h3>
            <% } %>
        </div>
    </div>
</body>
</html>
